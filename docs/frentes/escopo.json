    },
    "e-luz-viewer": {
      "permitir": ["src/viewer/EquipmentViewer.ts", "src/viewer/camera.ts", "src/viewer/lighting/**", "web/render.ts", "tests/viewer-lighting.test.ts"]
    },
    "f-render-offline": {
