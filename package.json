{
  "name": "@avilaops/gerador-3d",
  "version": "0.2.0",
  "description": "Gerador 3D paramétrico de equipamentos: spec (dimensões + família) → modelo Three.js, GLB, USDZ e planta 2D.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./viewer": "./src/viewer/EquipmentViewer.ts",
    "./viewer/react": "./src/viewer/EquipmentViewerView.tsx",
    "./catalogs/*": "./catalogs/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "specs": "vite-node scripts/build-specs.ts --",
    "export": "vite-node scripts/export.ts --",
    "thumbs": "vite-node scripts/thumbnails.ts --",
    "catalog": "npm run specs && npm run export -- --catalog ludus && npm run thumbs -- --catalog ludus"
  },
  "dependencies": {
    "three": "0.149.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/three": "^0.149.0",
    "puppeteer-core": "^24.0.0",
    "react": "^19.2.6",
    "typescript": "^5.4.0",
    "vite": "^7.0.0",
    "vite-node": "^3.2.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
